Перем юТест;

Функция ПолучитьСписокТестов(ЮнитТестирование) Экспорт
	юТест = ЮнитТестирование;
	ВсеТесты = Новый Массив;
	ВсеТесты.Добавить("ТестДолжен_Пройти");
	ВсеТесты.Добавить("ТестДолжен_Упасть");
	Возврат ВсеТесты;
КонецФункции

Процедура ТестДолжен_Пройти() Экспорт
	юТест.ПроверитьРавенство(2, 1 + 1);
КонецПроцедуры

Процедура ТестДолжен_Упасть() Экспорт
	юТест.ПроверитьРавенство("ожидали", "получили", "Демонстрация упавшего теста в отчете PR");
КонецПроцедуры
